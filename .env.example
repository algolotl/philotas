# Philotas environment — copy to .env.local to enable the keyed extensions.
# Every core layer is keyless; the app runs fully without any of this.

# --- Basemap (offline-first, keyless) ---
# The map uses MapLibre GL with a keyless basemap — no Google Maps, no API key.
# Defaults to the CARTO dark-matter vector style. Point this at a self-hosted
# tile/style server for air-gapped deployments.
# NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# --- Datastore ---
# Without DATABASE_URL the app uses a local JSON file under .data/. Set it to a
# Postgres connection string for a real, multi-replica datastore — tables are
# created automatically on first use.
# DATABASE_URL=postgres://postgres:philotas@127.0.0.1:5432/philotas

# --- Transport (Transport for NSW + Canberra light rail) ---
# One token covers the five realtime transport modes, the traffic cameras and the
# ferry positions that carry the vessel layer. Without it those layers report
# empty and say why.
# TFNSW_API_KEY=

# Override the Canberra light-rail GTFS-Realtime endpoint if it ever moves.
# ACT_LIGHTRAIL_URL=https://files.transport.act.gov.au/feeds/lightrail.pb

# --- CCTV ---
# By default the CCTV layer uses camera sites (locations only). To use a live
# GeoJSON camera feed (e.g. Transport for NSW Open Data), set CCTV_GEOJSON_URL
# and, if it needs auth, CCTV_AUTH as a single "Header-Name: value" pair.
# CCTV_GEOJSON_URL=https://...
# CCTV_AUTH=Authorization: apikey YOUR_KEY_HERE

# --- Fire hotspots (NASA FIRMS) ---
# NASA FIRMS map key for fire-hotspot detections. Without it the hotspots layer
# is empty and labelled.
# FIRMS_MAP_KEY=

# --- Aviation (OpenSky — opt-in) ---
# OpenSky is opt-in and bring-your-own-credentials (non-commercial terms apply).
# It is used only when BOTH credentials are present AND OPENSKY_ENABLE=1;
# otherwise the keyless adsb.fi source is the default.
# OPENSKY_ENABLE=1
# OPENSKY_CLIENT_ID=your_client_id
# OPENSKY_CLIENT_SECRET=your_client_secret
# Legacy basic-auth fallback (preferred is OAuth2 client credentials above):
# OPENSKY_USER=your_opensky_username
# OPENSKY_PASS=your_opensky_password

# --- Object detection (detect/ Python service) ---
# Address of the detection service. Defaults to http://127.0.0.1:8770.
# DETECTION_URL=http://127.0.0.1:8770
# Trained AutoGluon ObjectDetector directory — the default, supported engine.
# AG_MODEL_DIR=/path/to/models/traffic-v1
# Engine selector: auto (default) | autogluon | ultralytics. ultralytics is an
# explicit opt-in (AGPL-3.0) and only then is YOLO_MODEL honoured.
# DETECT_ENGINE=auto
# YOLO_MODEL=yolo11n.pt
# DETECT_CONF=0.25
# VIDEO_SAMPLE_EVERY=25
# VIDEO_MAX_FRAMES=40
# DETECTION_PORT=8770

# --- LLM adjudication (lib/llm.js provider adapter) ---
# Base URL of an OpenAI-compatible HTTP endpoint (chat / embeddings / rerank).
# When set, the adapter uses it for ontology adjudication and related calls;
# otherwise it falls back to the deterministic heuristic resolver.
# PHILOTAS_LLM_URL=http://localhost:8000/v1
# Alias for PHILOTAS_LLM_URL — either enables the HTTP provider.
# OPENAI_COMPATIBLE_ENDPOINT=http://localhost:8000/v1
# Set ONTOLOGY_LLM=off to force the heuristic resolver (skip the model).
# ONTOLOGY_LLM=off

# --- Webhooks ---
# Webhook actions in detection workflows POST the alert payload here when set
# per-workflow in the UI; leave unset to only raise in-app alerts.
# WORKFLOW_WEBHOOK_URL=
# Operator actions / write-back POST here when set; leave unset to only record to
# the audit trail.
# ACTIONS_WEBHOOK_URL=

# --- Auth and access ---
# PARALLAX_TRIAL=1 enables a read-only viewer session at POST /api/auth/guest for
# a public demonstrator. Leave unset for a private deployment.
# PARALLAX_TRIAL=
# ALLOW_INSECURE_COOKIE=1 allows the session cookie without the Secure flag.
# SECURITY: default is OFF (cookie is Secure). Only enable this for local HTTP
# development; never set it behind HTTPS or in production.
# ALLOW_INSECURE_COOKIE=
# PARALLAX_OPEN_READ=1 drops the read gate (read routes become unauthenticated).
# Intended for a public read-only demonstrator, not a private deployment.
# PARALLAX_OPEN_READ=
# Comma-separated regions pre-polled at boot. Defaults to sydney.
# PARALLAX_WARM_REGIONS=sydney

# --- Ingest service (ingest/, separate package) ---
# Region id recorded on AIS ingest events. Defaults to sydney.
# AIS_REGION=sydney
# Transport for NSW token for ferry positions — required by ingest.
# TFNSW_API_KEY=
# Postgres connection string for ingest output (shared with the app).
# DATABASE_URL=postgres://postgres:philotas@127.0.0.1:5432/philotas
